<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/contentRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_l"
        android:paddingTop="@dimen/spacing_m"
        android:paddingEnd="@dimen/spacing_l"
        android:paddingBottom="@dimen/spacing_xs">

        <ImageButton
            android:id="@+id/btnBackMovieCatalog"
            android:layout_width="@dimen/toolbar_icon_size"
            android:layout_height="@dimen/toolbar_icon_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:padding="@dimen/toolbar_icon_padding"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tvMovieTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_s"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            style="@style/TextAppearance.App.Title2" />
    </LinearLayout>

    <!-- Hero area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_l"
        android:paddingTop="@dimen/spacing_s"
        android:paddingEnd="@dimen/spacing_l"
        android:paddingBottom="@dimen/spacing_l">

        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/poster_width_l"
            android:layout_height="@dimen/poster_height_l"
            app:cardCornerRadius="@dimen/radius_m"
            app:cardElevation="4dp">

            <ImageView
                android:id="@+id/ivMoviePoster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/poster_placeholder" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_l"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMovieTitleZh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.App.Subhead" />

            <TextView
                android:id="@+id/tvMovieMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                style="@style/TextAppearance.App.Body" />

            <TextView
                android:id="@+id/btnMovieDetailRoute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:drawableStart="@drawable/ic_route"
                android:drawablePadding="@dimen/spacing_s"
                android:gravity="center_vertical"
                android:padding="@dimen/spacing_s"
                android:text="@string/action_route_planner"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/text_body"
                app:drawableTint="@color/colorPrimary" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="@dimen/spacing_l"
        android:background="@color/separator" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_l"
        android:paddingTop="@dimen/spacing_l"
        android:text="Scenes from this movie"
        style="@style/TextAppearance.App.Title2" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerMovieScenes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/spacing_l"
        android:paddingTop="@dimen/spacing_m"
        android:paddingEnd="@dimen/spacing_l" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_nav_separator"
        android:elevation="0dp"
        app:itemIconTint="@color/bottom_nav_item_tint"
        app:itemTextColor="@color/bottom_nav_item_tint"
        app:menu="@menu/menu_bottom_nav" />
</LinearLayout>
