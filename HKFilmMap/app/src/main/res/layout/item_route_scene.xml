<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_s"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="@dimen/radius_l"
    app:cardElevation="0dp"
    app:strokeColor="@color/separator"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_m">

        <TextView
            android:id="@+id/tvRouteOrder"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_genre_badge"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_subhead"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:layout_width="52dp"
            android:layout_height="72dp"
            android:layout_marginStart="@dimen/spacing_s"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="@dimen/radius_s"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/ivRoutePoster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/poster_placeholder" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRouteMovie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                style="@style/TextAppearance.App.Headline" />

            <TextView
                android:id="@+id/tvRoutePlace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                style="@style/TextAppearance.App.Subhead" />

            <TextView
                android:id="@+id/tvRouteScene"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                style="@style/TextAppearance.App.Caption" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnRouteCheckIn"
                android:layout_width="@dimen/icon_action_size"
                android:layout_height="@dimen/icon_action_size"
                android:background="@drawable/bg_icon_action_circle"
                android:contentDescription="@string/action_check_in"
                android:padding="@dimen/icon_action_padding"
                android:scaleType="centerInside"
                android:src="@drawable/ic_check_in" />

            <ImageButton
                android:id="@+id/btnRemoveRouteStop"
                android:layout_width="@dimen/icon_action_size"
                android:layout_height="@dimen/icon_action_size"
                android:layout_marginStart="@dimen/spacing_xs"
                android:background="@drawable/bg_icon_action_circle"
                android:contentDescription="@string/action_remove_route"
                android:padding="@dimen/icon_action_padding"
                android:scaleType="centerInside"
                android:src="@drawable/ic_remove" />

            <ImageButton
                android:id="@+id/btnNearbyFood"
                android:layout_width="@dimen/icon_action_size"
                android:layout_height="@dimen/icon_action_size"
                android:layout_marginStart="@dimen/spacing_xs"
                android:background="@drawable/bg_icon_action_circle"
                android:contentDescription="@string/nearby_food_btn"
                android:padding="@dimen/icon_action_padding"
                android:scaleType="centerInside"
                android:src="@drawable/ic_food" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
