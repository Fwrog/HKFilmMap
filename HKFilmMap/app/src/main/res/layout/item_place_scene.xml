<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_s"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="@dimen/radius_l"
    app:cardElevation="0dp"
    app:strokeColor="@color/separator"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_l">

        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/poster_width_s"
            android:layout_height="@dimen/poster_height_s"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="@dimen/poster_corner"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/ivScenePoster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/poster_placeholder" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSceneMovieTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                style="@style/TextAppearance.App.Headline" />

            <TextView
                android:id="@+id/tvSceneMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                style="@style/TextAppearance.App.Caption" />

            <TextView
                android:id="@+id/tvSceneDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:ellipsize="end"
                android:maxLines="2"
                style="@style/TextAppearance.App.Subhead" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnSceneCheckIn"
                    android:layout_width="@dimen/icon_action_size"
                    android:layout_height="@dimen/icon_action_size"
                    android:background="@drawable/bg_icon_action_circle"
                    android:contentDescription="@string/action_check_in"
                    android:padding="@dimen/icon_action_padding"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_check_in" />

                <ImageButton
                    android:id="@+id/btnSceneRoute"
                    android:layout_width="@dimen/icon_action_size"
                    android:layout_height="@dimen/icon_action_size"
                    android:layout_marginStart="@dimen/spacing_s"
                    android:background="@drawable/bg_icon_action_circle"
                    android:contentDescription="@string/action_add_route"
                    android:padding="@dimen/icon_action_padding"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_add_route" />

                <ImageButton
                    android:id="@+id/btnSceneOpenMovie"
                    android:layout_width="@dimen/icon_action_size"
                    android:layout_height="@dimen/icon_action_size"
                    android:layout_marginStart="@dimen/spacing_s"
                    android:background="@drawable/bg_icon_action_circle"
                    android:contentDescription="@string/action_open_movie"
                    android:padding="@dimen/icon_action_padding"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_chevron_right" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvSceneStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextAppearance.App.Caption" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
